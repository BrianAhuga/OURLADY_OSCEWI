@page "/Enrollment"
@model OurLadyPS.Web.Pages.EnrollmentModel
@{
    ViewData["Title"] = "Enrollment";
}


<!-- Page Title -->
<div class="page-title dark-background" style="background-image: url(assets/img/education/showcase-1.webp);">
    <div class="container position-relative">
        <h1>Child Enrollment</h1>
        <p>
            Welcome to Our Lady Parents' School enrollment portal. Please complete the form below
            to apply for admission. We are committed to providing a nurturing and supportive
            environment where every child can grow, learn, and thrive. Kindly ensure that all
            details are accurate to help us process your application smoothly.
        </p>

        <nav class="breadcrumbs">
            <ol>
                <li><a href="Index">Home</a></li>
                <li class="current">Enrollment</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- Starter Section Section -->
