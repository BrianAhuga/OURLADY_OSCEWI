@page "/Enrollment"
@model OurLadyPS.Web.Pages.EnrollmentModel
@{
    ViewData["Title"] = "Enrollment";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<!-- Page Title -->
<div class="page-title dark-background" style="background-image: url(assets/img/education/showcase-1.webp);">
    <div class="container position-relative">
        <h1>Child Enrollment</h1>
        <p>
            Welcome to Our Lady Parents' School enrollment portal. Please complete the form below
            to apply for admission. We are committed to providing a nurturing and supportive
            environment where every child can grow, learn, and thrive. Kindly ensure that all
            details are accurate to help us process your application smoothly.
        </p>

        <nav class="breadcrumbs">
            <ol>
                <li><a href="Index">Home</a></li>
                <li class="current">Enrollment</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- Starter Section Section -->
<section id="starter-section" class="starter-section section">

    <div class="container" data-aos="fade-up">
        <form method="post" class="row g-3" id="enrollmentForm">
            <div class="col-md-6">
                <label asp-for="Enrollment.FirstName" class="form-label"></label>
                <input asp-for="Enrollment.FirstName" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="Enrollment.LastName" class="form-label"></label>
                <input asp-for="Enrollment.LastName" class="form-control" required />
            </div>

            <div class="col-3">
                <label asp-for="Enrollment.DateOfBirth" class="form-label">Date Of Birth</label>
                <input asp-for="Enrollment.DateOfBirth" type="date" class="form-control" required />
            </div>

            <div class="col-3">
                <label asp-for="Enrollment.Gender" class="form-label">Gender</label>
                <select asp-for="Enrollment.Gender" class="form-control" required>
                    <option value="">-- Select Gender --</option>
                    <option value="male" selected="@(Model.Enrollment?.Gender == "male")">Male</option>
                    <option value="female" selected="@(Model.Enrollment?.Gender == "female")">Female</option>
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="Enrollment.ClassApplyingFor" class="form-label">Class Applying for</label>
                <select asp-for="Enrollment.ClassApplyingFor" class="form-control" required>
                    <option value="">-- Select Class --</option>
                    <option value="babyclass" selected="@(Model.Enrollment?.ClassApplyingFor == "babyclass")">Baby Class</option>
                    <option value="middleclass" selected="@(Model.Enrollment?.ClassApplyingFor == "middleclass")">Middle Class</option>
                    <option value="topclass" selected="@(Model.Enrollment?.ClassApplyingFor == "topclass")">Top Class</option>
                    <option value="primaryone" selected="@(Model.Enrollment?.ClassApplyingFor == "primaryone")">Primary One</option>
                    <option value="primarytwo" selected="@(Model.Enrollment?.ClassApplyingFor == "primarytwo")">Primary Two</option>
                    <option value="primarythree" selected="@(Model.Enrollment?.ClassApplyingFor == "primarythree")">Primary Three</option>
                    <option value="primaryfour" selected="@(Model.Enrollment?.ClassApplyingFor == "primaryfour")">Primary Four</option>
                    <option value="primaryfive" selected="@(Model.Enrollment?.ClassApplyingFor == "primaryfive")">Primary Five</option>
                    <option value="primarysix" selected="@(Model.Enrollment?.ClassApplyingFor == "primarysix")">Primary Six</option>
                    <option value="primaryseven" selected="@(Model.Enrollment?.ClassApplyingFor == "primaryseven")">Primary Seven</option>
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="Enrollment.FormerSchool" class="form-label">Former School</label>
                <input asp-for="Enrollment.FormerSchool" class="form-control" required placeholder="If none write [None]"/>
            </div>

            <div class="col-md-6">
                <label asp-for="Enrollment.ParentGuardian" class="form-label">Parent/Guardian</label>
                <input asp-for="Enrollment.ParentGuardian" class="form-control" required/>
            </div>

            <div class="col-md-3">
                <label asp-for="Enrollment.ParentEmail" class="form-label">Email</label>
                <input asp-for="Enrollment.ParentEmail" type="email" class="form-control" required/>
            </div>

            <div class="col-md-3">
                <label asp-for="Enrollment.ParentPhone" class="form-label">Phone Number</label>
                <input asp-for="Enrollment.ParentPhone" type="number" min="10" max="12" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="Enrollment.Address" class="form-label">Address</label>
                <input asp-for="Enrollment.Address" class="form-control" required/>
            </div>

            <div class="col-md-4">
                <label asp-for="Enrollment.AddressLine1" class="form-label">Address Line 1</label>
                <input asp-for="Enrollment.AddressLine1" class="form-control" placeholder="City" required/>
            </div>

            <div class="col-md-4">
                <label asp-for="Enrollment.AddressLine2" class="form-label">Address Line 2</label>
                <input asp-for="Enrollment.AddressLine2" class="form-control" placeholder="State/Province/Region" required/>
            </div>

            <div class="col-md-4">
                <label asp-for="Enrollment.Country" class="form-label">Country</label>
                <select asp-for="Enrollment.Country" class="form-control" required>
                    <option value="">-- Select Country --</option>
                    <option value="uganda" selected="@(Model.Enrollment?.Country == "uganda")">Uganda</option>
                    <option value="kenya" selected="@(Model.Enrollment?.Country == "kenya")">Kenya</option>
                    <option value="tanzania" selected="@(Model.Enrollment?.Country == "tanzania")">Tanzania</option>
                    <option value="united-kingdom" selected="@(Model.Enrollment?.Country == "united-kingdom")">United Kingdom</option>
                    <option value="united-states" selected="@(Model.Enrollment?.Country == "united-states")">United States</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Do you have other children in Our Lady Parents' School?</label>
                <br />
                <div class="form-check form-check-inline">
                    <input asp-for="Enrollment.HasOtherChildren" class="form-check-input" type="radio" value="true" checked="@(Model.Enrollment?.HasOtherChildren == true)" />
                    <label class="form-check-label">Yes</label>
                </div>
                <div class="form-check form-check-inline">
                    <input asp-for="Enrollment.HasOtherChildren" class="form-check-input" type="radio" value="false" checked="@(Model.Enrollment?.HasOtherChildren == false)" />
                    <label class="form-check-label">No</label>
                </div>

                <div id="childrenDetails" class="mt-3" style="display:@(Model.Enrollment?.HasOtherChildren == true ? "block" : "none");">
                    <label asp-for="Enrollment.OtherChildrenDetails" class="form-label"><i>State the Number of Children and Class:</i></label>
                    <textarea asp-for="Enrollment.OtherChildrenDetails" class="form-control" rows="3" placeholder="Enter details here..."></textarea>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-4">
                    <button type="submit" class="btn btn-danger" id="submitBtn">
                        <span id="btnText">Submit</span>
                        <span id="spinner" class="spinner-border spinner-border-sm d-none"></span>
                    </button>
                </div>
            </div>

            
        </form>
    </div>

</section><!-- /Starter Section Section -->


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        // Toggle children details when selecting Yes/No
        document.querySelectorAll("input[name='Enrollment.HasOtherChildren']").forEach(el => {
            el.addEventListener("change", function () {
                document.getElementById("childrenDetails").style.display =
                    this.value === "true" ? "block" : "none";
            });
        });

        // Show loading spinner on submit
        document.getElementById("enrollmentForm").addEventListener("submit", function () {
            document.getElementById("btnText").textContent = "Submitting...";
            document.getElementById("spinner").classList.remove("d-none");
            document.getElementById("submitBtn").disabled = true;
        });

        // SweetAlert after post
        @if (TempData["Message"] != null)
        {
                <text>
                    Swal.fire({
                        icon: '@(TempData["Success"] != null && (bool)TempData["Success"] ? "success" : "error")',
                        title: '@(TempData["Success"] != null && (bool)TempData["Success"] ? "Success!" : "Failed!")',
                        text: '@TempData["Message"]',
                        confirmButtonColor: "#dc3545"
                    });
                </text>
        }
    </script>
}