@page "/About"
@model OurLadyPS.Web.Pages.AboutModel
@{
    ViewData["Title"] = "About";
}

<!-- Page Title -->
<div class="page-title dark-background" style="background-image: url(assets/img/aboutpage/classroom.jpg);">
    <div class="container position-relative">
        <h1>About</h1>
        <p>
            Welcome to Our Lady Parents’ School, a nurturing community where faith, learning, and character come together
            to prepare children for success in school and life.
        </p>
        <nav class="breadcrumbs">
            <ol>
                <li><a href="Index">Home</a></li>
                <li class="current">About</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- History Section -->
<section id="history" class="history section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="about-content" data-aos="fade-up" data-aos-delay="200">
                    <h3>Our Story</h3>
                    <h4>Brief Background</h4>
                    <p>
                        Our journey started with 20 students in 2001.
                        We have been achieving simple milestones every after any academic year. Here, we also seek to provide a homely, supportive,
                        well-maintained and hygienic boarding environment needed for our learners to develop their academic, co-curricular and spiritual aspects hence,
                        developing into well-rounded individuals.
                    </p>

                    <h4>Holistic Education</h4>
                    <p>
                        At the heart of Ourlady Parents’ School lies high quality education. Ourlady Parents’ School provides opportunities
                        for the students to develop international and intercultural knowledge and skills, both within the formal curriculum and through a
                        range of age and developmentally-appropriate activities, learning experiences, and opportunities.
                    </p>

                    <h4>Leading Teachers</h4>
                    <p>
                        We are proud to recruit and retain the best teachers who are committed to nurturing and inspiring every child for which they care.
                        We support them to achieve this through world-class professional development, strengthened by the sharing of international best practices
                    </p>

                    <h4>Academic and Social Achievement</h4>
                    <p>
                        At Ourlady Parents’ School, the majority of students exhibit outstanding performances in the theology and the popular Secular curricula.
                        We inspire our children through a number of Awards, hour of code a week, games and a good record of achievement in the Primary Leaving Examinations,
                        PLE.
                    </p>

                    <h4>Boarding Section</h4>
                    <p>
                        Our boarding facility can house up to 600 pupils and caters for both males and females ranging from Nursery section to Primary 7 (P.7).
                        The facility is overseen by the Head of the Boarding Section.
                    </p>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="about-image" data-aos="zoom-in" data-aos-delay="300">
                    <img src="assets/img/all/11.webp" alt="Campus" class="img-fluid rounded">

                    <div class="mission-vision" data-aos="fade-up" data-aos-delay="400">
                        <div class="mission">
                            <h3>Mission Statement</h3>
                            <p>
                                “To produce all round pupils who fit in the ever challenging world”
                            </p>
                        </div>

                        <div class="vision">
                            <h3>Our Vision</h3>
                            <p>
                                To educate and train for Nations
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section><!-- /History Section -->
