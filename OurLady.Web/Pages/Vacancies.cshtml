@page "/Vacancies"
@model OurLadyPS.Web.Pages.VacanciesModel
@{
    ViewData["Title"] = "Vacancies";
}

<!-- SweetAlert2 CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<!-- Page Title -->
<div class="page-title dark-background" style="background-image: url(assets/img/education/showcase-1.webp);">
    <div class="container position-relative">
        <h1>Job Application</h1>
        <p>
            At Ourlady Parents’ School we are always in need of Highly experienced and talented teachers needed to teach English, Mathematics, Science, Global Perspectives, Humanities and Personal Social Health Education.
        </p>

        <nav class="breadcrumbs">
            <ol>
                <li><a href="Index">Home</a></li>
                <li class="current">Vacancies</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->


<section id="starter-section" class="starter-section section">

    <div class="container" data-aos="fade-up">
        <h3>How to Apply</h3>
        <p>
            Please send your cover letter, resume, recent passport size photo, national ID/passport,
            academic credentials and contact of three professional referees to the head teacher on
            <a href="mailto:info@ourladyps.org">info@ourladyps.org</a> indicating clearly the job position(s) you are applying for in the email subject. Or Fill the form below.
        </p>
        <br />

        <h3>Job Application Form</h3>
        <hr />

        <!-- Your Form -->
        <form id="jobApplicationForm" class="row g-3 mt-2" method="post" enctype="multipart/form-data">
            <div class="col-md-6">
                <label for="FullName" class="form-label">Full Name</label>
                <input type="text" class="form-control" id="FullName" name="FullName" required>
            </div>

            <div class="col-md-6">
                <label for="Email" class="form-label">Email Address</label>
                <input type="email" class="form-control" id="Email" name="Email" required>
            </div>

            <div class="col-md-6">
                <label for="PhoneNumber" class="form-label">Phone Number</label>
                <input type="tel" class="form-control" id="PhoneNumber" name="PhoneNumber"
                       pattern="[0-9+]{10,15}" required>
            </div>

            <div class="col-md-6">
                <label for="Position" class="form-label">Position Applying for</label>
                <input type="text" class="form-control" id="Position" name="Position" required>
            </div>

            <div class="col-md-3">
                <label for="CoverLetter" class="form-label">Cover Letter</label>
                <input class="form-control" type="file" id="CoverLetter" name="CoverLetter" accept=".pdf,.doc,.docx">
            </div>

            <div class="col-md-3">
                <label for="CV" class="form-label">CV & References</label>
                <input class="form-control" type="file" id="CV" name="CV" accept=".pdf,.doc,.docx">
            </div>

            <div class="col-md-3">
                <label for="IDPassport" class="form-label">ID/Passport</label>
                <input class="form-control" type="file" id="IDPassport" name="IDPassport" accept=".jpg,.jpeg,.png">
            </div>

            <div class="col-md-3">
                <label for="AcademicDocs" class="form-label">Academic Documents</label>
                <input class="form-control" type="file" id="AcademicDocs" name="AcademicDocs" accept=".pdf,.doc,.docx">
            </div>

            <div class="col-md-12">
                <label for="About" class="form-label">
                    Tell us about yourself and the job you are interested in.
                </label>
                <textarea class="form-control" id="About" name="About" rows="5" placeholder="Enter details here..."></textarea>
            </div>

            <div class="col-12">
                <button id="submitBtn" type="submit" class="btn btn-danger">
                    <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span id="btnText">Submit Form</span>
                </button>
            </div>
        </form>
    </div>

</section>

@section Scripts {
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.getElementById('jobApplicationForm').addEventListener('submit', function (e) {
            e.preventDefault(); // prevent default form submission

            Swal.fire({
                title: 'Submit Application?',
                text: "Please confirm you want to submit this job application.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Submit!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Show spinner and disable button
                    document.getElementById('btnSpinner').classList.remove('d-none');
                    document.getElementById('btnText').innerText = "Submitting...";
                    document.getElementById('submitBtn').disabled = true;

                    this.submit(); // proceed with form submission
                }
            });
        });
    </script>
}