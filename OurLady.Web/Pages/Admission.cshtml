@page "/Admission"
@model OurLadyPS.Web.Pages.AdmissionModel
@{
    ViewData["Title"] = "Admission";
}


<!-- Page Title -->
<div class="page-title dark-background" style="background-image: url(assets/img/aboutpage/classroom.jpg);">
    <div class="container position-relative">
        <h1>Admissions</h1>
        <p>Shaping young minds with excellence, faith, discipline, and integrity</p>
        <nav class="breadcrumbs">
            <ol>
                <li><a href="Index">Home</a></li>
                <li class="current">Admissions</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- Starter Section Section -->
<section id="starter-section" class="starter-section section">

    <div class="container" data-aos="fade-up">
        <p>
            At Our Lady Parents’ School, every pupil is welcomed into a safe, homely, and supportive environment where
            they are given the opportunity to thrive academically, socially, and spiritually.
        </p>

        <p>
            Parents can be assured that their children will benefit from:
        </p>
        <ul>
            <li>
                <strong>Quality Education:</strong> A strong academic program designed to prepare learners to excel in the
                Primary Leaving Examinations (PLE) and beyond.
            </li>
            <li>
                <strong>Character Development:</strong> We instill discipline, integrity, and values that shape
                responsible, well-rounded individuals.
            </li>
            <li>
                <strong>Boarding & Day Facilities:</strong> A hygienic, well-maintained, and nurturing environment that
                feels like a second home.
            </li>
            <li>
                <strong>Co-curricular Growth:</strong> Opportunities to explore talents through sports, clubs, arts, and
                cultural activities.
            </li>
            <li>
                <strong>Spiritual Guidance:</strong> A faith-based foundation that encourages moral strength and
                purpose-driven living.
            </li>
        </ul>

        <p>
            Admission is open to pupils of all backgrounds who are eager to learn, grow, and succeed. Together, we work to
            ensure every child develops into a confident, disciplined, and empowered learner.
        </p>


        <div class="download-links d-flex flex-column flex-sm-row gap-3 mt-4">
            <a href="assets/Files/BOARDING-REQUIREMENTS.pdf" target="_blank" class="btn btn-primary">
                📄 Download School Fees Structure
            </a>
            <a href="assets/Files/DAY-SCH-TWO-REQ.pdf" target="_blank" class="btn btn-secondary">
                📘 Download School Curricular
            </a>
        </div>
    </div>

</section><!-- /Starter Section Section -->